# BillMind 配置模板 

# --- LLM（必填）---
deepseek_api_key: ""

# 可选：终端 SOCKS 代理时必须走代理时设为 true，并 pip install "httpx[socks]"
# deepseek_use_system_proxy: false

# DeepSeek Chat 模型 ID（默认 deepseek-v4-flash；legacy deepseek-chat 将于 2026-07-24 退役）
# deepseek_model: deepseek-v4-flash

# V4 推理强度（Agent 默认 low；可选 low / medium / high；none 表示不传）
# deepseek_reasoning_effort: low
# 旧键 deepseek_thinking_disabled: true 仍兼容，等价于 low

# --- Database ---
# 本地
database_url: postgresql+asyncpg://billmind:billmind@localhost:5432/billmind

# AsyncPostgresSaver 连接池 max_size（默认 5）
# checkpointer_pool_max: 5

# --- Ollama ---
# 本地
ollama_uri: http://ollama:11434
ollama_vision_model: qwen2.5vl:7b
ollama_embedding_model: nomic-embed-text


# --- MCP / Geo ---
amap_maps_api_key: ""
# geo_default_ip: ""

# --- RAG（Milvus + Ollama embedding）---
milvus_uri: http://milvus:19530
rag_top_k: 4

# --- 交易语义搜索（记账后自动 upsert 向量，设为 false 关闭）---
# txn_search_incremental: true

# --- LangSmith（APAC endpoint；勿提交真实 Key）---
langsmith_tracing: true
langsmith_endpoint: https://apac.api.smith.langchain.com
langsmith_api_key: ""
langsmith_project:
